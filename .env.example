# Copiez les variables dans votre shell avant npm run dev (aucun .env chargé implicitement).
PORT=5173
HOST=0.0.0.0
# Pour le téléphone : HTTPS avec certificat approuvé par les deux appareils.
# HTTPS_KEY_FILE=.certs/local-key.pem
# HTTPS_CERT_FILE=.certs/local-cert.pem
# Ou URL HTTPS publique du reverse proxy/tunnel pointant vers le même serveur.
# PUBLIC_ORIGIN=https://cooking.example.com

# Dossier privé du classement, un seul serveur par dossier.
# STAND_DATA_DIR=/chemin/vers/classement-salon
